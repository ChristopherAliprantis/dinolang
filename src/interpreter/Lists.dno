#func Ssplitandkeeponright(value, splitter);
    LIST = Ssplit(value, splitter);
    len = Llen(LIST);
    i = 0;
    #loop(len);
        existing = AtLIndex(LIST, i);
        new = +(existing, splitter);
        AssignAtLIndex(LIST, i, new);
        i = +(i, 1);
    #endloop;
    return(LIST);
#endfunc;

#func Ssplitandkeeponleft(value, splitter);
    LIST = Ssplit(value, splitter);
    len = Llen(LIST);
    i = 0;
    #loop(len);
        existing = AtLIndex(LIST, i);
        new = +(splitter, existing);
        AssignAtLIndex(LIST, i, new);
        i = +(i, 1);
    #endloop;
    return(LIST);
#endfunc;

#func Lcontains(LIST, value);
    len = Llen(LIST);
    i = 0;
    #loop(len);
        here = AtLIndex(LIST, i);
        if (==(here, value));
            return(true);
        #endif;
        i = +(i, 1);
    #endloop;
    return(false);
#endfunc;