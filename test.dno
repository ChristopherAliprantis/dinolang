var = :Turning a Struct into JSON:;

separator(var);

#struct Person;
    name;
    age;
    gender;
#endstruct;

p = NewStruct(:Person:);
p.name = :John Doe:;
p.age = 30;
p.gender = :male:;

pd = StructToDictionary(p);
pd = JSONSerialize(pd);

print(pd);