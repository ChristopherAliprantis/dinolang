//Test file for The Dino Programming Language.;

#func separator(in)a;
    print();
    print(:------------------------------:);
    print(+(in, COLON));
    print();
#endfunc;

#func intpower(in, to);
    current = 1;
    #loop(to);
        current = *(current, in);
    #endloop;
    return(current);
#endfunc;

var = :integer exponent(2^8):;
separator(var);

print(intpower(2, 8));

var = :fibonacci sequence(to the 10th):;
separator(var);

count = 10;
now = 0;
last = 1;
temp = 0;
#loop (count);
    printnnl(now);
    print(:,:);
    temp = now;
    now = +(now, last);
    last = temp;
#endloop;

