var = :both types of division:;

separator(var);

printnnl(+(:num:, COLON, : :));
num1 = ToNum(ReadLine());
printnnl(+(:divided by:, COLON, : :));
num2 = ToNum(ReadLine());

num = FD(num1, num2);
remainder = %(num1, num2);
print(+(ToString(num), : R:, ToString(remainder)));
num = /(num1, num2);
print(ToString(num));

